{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "permissions": {
    "allow": [
      "Bash(git status:*)",
      "Bash(git log:*)",
      "Bash(git diff:*)",
      "Bash(git show:*)",
      "Bash(git add:*)",
      "Bash(git commit:*)",
      "Bash(git fetch:*)",
      "Bash(git pull:*)",
      "Bash(git switch:*)",
      "Bash(git checkout:*)",
      "Bash(git branch:*)",
      "Bash(git cherry:*)",
      "Bash(git push:*)",
      "Bash(supabase:*)",
      "Bash(flutter:*)",
      "Bash(dart:*)"
    ],
    "deny": [
      "Bash(supabase db push:*)",
      "Bash(supabase db reset:*)",
      "Bash(psql:*)"
    ]
  }
}
