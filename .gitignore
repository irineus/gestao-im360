# Flutter / Dart
.dart_tool/
.packages
build/
.flutter-plugins
.flutter-plugins-dependencies
*.iml
.idea/

# Supabase local
supabase/.temp/
supabase/.branches/

# Segredos e ambiente
.env
.env.*
*.key
# Chaves do vigia para rodar `wrangler dev` na máquina (card 3.10). As de verdade
# vivem em secret do repositório; este arquivo nunca é commitado.
worker-vigia/.dev.vars

# Cloudflare / wrangler
.wrangler/

# SO / editor
.DS_Store
.vscode/
node_modules/

# Worktrees de sessões paralelas do Claude Code (card 4.7): duas sessões no
# mesmo repositório trabalham cada uma no seu, e o checkout principal não pode
# ver o outro como arquivo solto — um `git add -A` o commitaria inteiro.
.claude/worktrees/

# Saída da cadeia de execução (card 5.5,5) — log de corrida, não é entregável
automacao/logs/

# Planilha e saída do extrator (card 9.2). ⚠️ Não é arrumação: o JSON traz NOME,
# CÓDIGO SGF e trilha de cada aluno da escola, e o `--saida` padrão é o diretório
# atual. Um `git add -A` depois de uma extração na raiz commitaria a escola inteira
# num repositório PÚBLICO. A planilha original nunca esteve aqui e não deve estar.
*.xlsx
importacao-*.json
inconsistencias-*.csv
extracao/saida/
